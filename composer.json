{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ironflow/halo-ui",
    "description": "A modern, accessible and customizable Blade UI component library for Laravel.",
    "keywords": [
        "laravel",
        "blade",
        "ui",
        "components",
        "tailwindcss",
        "alpinejs",
        "design-system",
        "blade-components"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aure Dulvresse",
            "email": "marrow.framework@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "blade-ui-kit/blade-icons": "^1.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Halo\\UI\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Halo\\UI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Halo\\UI\\Providers\\HaloServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
